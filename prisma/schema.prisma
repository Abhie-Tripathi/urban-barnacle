generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserSource {
  SELF
  PROMOTE_EVENT
  PROMOTE_EVENT_INVITE
  ACCESS_INVITE
  SCRIPT
  IMPORT_10T
}

model User {
  id                         String                @id @default(uuid()) @db.Uuid
  firstname                  String?
  lastname                   String?
  email                      String                @unique
  role                       UserRole              @default(CUSTOMER)
  source                     UserSource            @default(SELF)
  industry                   String?
  category                   String?
  subIndustry                String?
  socialIds                  Json?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  phoneNumber                String?
  primaryCompanyId           String?               @db.Uuid
  primaryAccountId           String?               @db.Uuid
  company                    Company?              @relation(fields: [primaryCompanyId], references: [id])
  // aliasName              String? // discuss with gaurav
  currentOnboardingState     OnboardingState       @default(VERIFICATION)
  primaryLocation            Json?
  imageUrl                   String?
  profileImageId             String?
  designation                String? // discuss with gaurav
  department                 String? // discuss with gaurav
  deleted                    Boolean               @default(false)
  userInterests              UserEventInterest[]   @relation("interestedUser")
  approvingInterests         UserEventInterest[]   @relation("approvedBy")
  recommendingInterests      UserEventInterest[]   @relation("recommendedBy")
  ownedEnquiries             Enquiry[]             @relation("owner")
  initiatedEnquiries         Enquiry[]             @relation("initiatedBy")
  comments                   Comment[]
  accounts                   Account[]
  intents                    Intent[]
  enquiryActivities          EnquiryActivity[]
  exports                    Export[]
  userActivities             UserActivity[]
  apiLogs                    ApiLogs[]
  verificationPasskeys       Verification[]
  accessProvided             Access[]              @relation("accessProvider")
  accessReceived             Access[]              @relation("accessReceiver")
  accessDeletedByUser        Access[]              @relation("accessDeletedByUser")
  attachments                Attachment[]
  createdTrackers            Tracker[]             @relation("createdByUser")
  modifiedTrackers           Tracker[]             @relation("modifiedByUser")
  savedLocations             SavedLocation[]
  unlockedTransactions       UnlockedTransaction[]
  createdEvents              Event[]
  // userConfigurations         UserConfiguration[]
  // createdConfigurations      Configuration[]       @relation("createdBy")
  lastModifiedConfigurations Configuration[]       @relation("lastModifiedBy")
  Invitation                 Invitation[]
  Widget                     Widget[]
  CustomBrandKit             CustomBrandKit[]
  requestedJobs              RequestedJob[]
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  domain         String   @unique
  website        String?
  imageUrl       String?
  profileImageId String?
  accountId      String   @unique @db.Uuid
  accounts       Account  @relation(references: [id], fields: [accountId])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deleted        Boolean  @default(false)
  users          User[]
}

enum SubscriptionPlan {
  BASIC
  ESSENTIAL
  SCALE
  ADVANCE
  ENTERPRISE
}

model Subscription {
  id                               String           @id @default(uuid()) @db.Uuid
  plan                             SubscriptionPlan @default(BASIC)
  planStartDate                    DateTime         @default(now())
  planEndDate                      DateTime // default 1 year or 3 month
  purchaseValue                    Float            @default(0)
  currency                         String           @default("usd")
  pendingRequests                  Int              @default(200)
  pendingPocUnlockRequests         Int              @default(4400)
  pendingCompanySearchRequests     Int              @default(20)
  pendingProspectPocUnlockRequests Int              @default(200)
  account                          Account?         @relation(fields: [accountId], references: [id])
  accountId                        String?          @db.Uuid
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt
}

model Account {
  id                    String                @id @default(uuid()) @db.Uuid
  currentSubscriptionId String                @db.Uuid
  user                  User[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deleted               Boolean               @default(false)
  domain                String?
  configurationId       String                @unique @db.Uuid
  userInterests         UserEventInterest[]
  enquiries             Enquiry[]
  exports               Export[]
  unlockedTransactions  UnlockedTransaction[]
  events                Event[]
  // accountConfigurations    AccountConfiguration[]
  accountConfiguration  Configuration         @relation(fields: [configurationId], references: [id])
  invitations           Invitation[]
  trackers              Tracker[]
  customBrandKit        CustomBrandKit?
  widgets               Widget[]
  company               Company?
  intents               Intent[]
  comments              Comment[]
  enquiryActivities     EnquiryActivity[]
  userActivities        UserActivity[]
  apiLogs               ApiLogs[]
  savedLocations        SavedLocation[]
  accessProvided        Access[]
  subscription          Subscription[]
}

model Attachment {
  id              String                 @id @default(uuid()) @db.Uuid
  fileUrl         String                 @unique
  fileType        FileType
  fileName        String
  fileSize        Float // kb
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdByUser   User                   @relation(fields: [createdByUserId], references: [id])
  createdByUserId String                 @db.Uuid
  deleted         Boolean                @default(false)
  sourceModule    AttachmentSourceModule
  sourceId        String
  event           Event[]
}

enum AttachmentSourceModule {
  COMMENT
  TRACKER
  USER
  ACCOUNT
  EVENT
  BRANDKIT
  PROMOTED_EVENT
  PROMOTED_EVENT_WIDGET_KIT
  PROMOTED_EVENT_SPEAKER
  PROMOTED_EVENT_EXHIBITOR
  OTHERS
}

// discuss source : gtm geni usecase
// discuss recommendation confirmation
// discuss if we want to capture all recommendation for a given user interest
// recommended array
model UserEventInterest {
  id               String               @id @default(uuid())
  accountId        String               @db.Uuid
  enquiryId        String?              @db.Uuid
  eventId          String
  note             String?
  sourceModule     InterestSourceModule
  sourceId         String?
  status           InterestStatus       @default(PENDING)
  interest         Interest
  modifiedBy       String               @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deleted          Boolean              @default(false)
  account          Account?             @relation(fields: [accountId], references: [id])
  approvingUser    User?                @relation("approvedBy", fields: [approvedBy], references: [id])
  approvedBy       String?              @db.Uuid
  recommendingUser User?                @relation("recommendedBy", fields: [recommendedBy], references: [id])
  recommendedBy    String?              @db.Uuid
  interestedUser   User                 @relation("interestedUser", fields: [interestedUserId], references: [id])
  interestedUserId String               @db.Uuid
  enquiry          Enquiry?             @relation(fields: [enquiryId], references: [id])
}

// discuss with vipul, if we want to create enquiry without creating user interest first
model Enquiry {
  id              String              @id @default(uuid()) @db.Uuid
  status          EnquiryStatus       @default(PENDING)
  eventId         String
  accountId       String              @db.Uuid
  // eventData       Json
  account         Account?            @relation(fields: [accountId], references: [id])
  initiatedBy     String              @db.Uuid
  initiatedByUser User?               @relation("initiatedBy", fields: [initiatedBy], references: [id])
  ownerId         String?             @db.Uuid
  owner           User?               @relation("owner", fields: [ownerId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deleted         Boolean             @default(false)
  userInterests   UserEventInterest[]
  activities      EnquiryActivity[]

  @@unique([accountId, eventId], name: "unique_enquiry") // adds constraint to the table to avoid duplicate entries for a given enquiry for a given user of specific account
}

model Comment {
  id              String              @id @default(uuid()) @db.Uuid
  content         String?
  commentType     CommentType
  user            User                @relation(fields: [userId], references: [id])
  userId          String              @db.Uuid
  accountId       String              @db.Uuid
  account         Account             @relation(fields: [accountId], references: [id])
  sourceModule    CommentSourceModule
  sourceId        String
  parentCommentId String?             @db.Uuid
  parentComment   Comment?            @relation("parentComment", fields: [parentCommentId], references: [id])
  totalLikes      Int                 @default(0)
  attachments     String[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deleted         Boolean             @default(false)
  replies         Comment[]           @relation("parentComment")
}

model Intent {
  id           String             @id @default(uuid()) @db.Uuid
  targetModule IntentTargetModule
  targetId     String
  intentType   IntentType
  userId       String             @db.Uuid
  user         User               @relation(fields: [userId], references: [id])
  accountId    String?            @db.Uuid
  account      Account?           @relation(fields: [accountId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deleted      Boolean            @default(false)

  @@unique([targetModule, targetId, userId, intentType, accountId], name: "unique_intent")
}

enum IntentTargetModule {
  COMMENT
}

enum IntentType {
  UPVOTE
}

enum CommentType {
  TEXT
  RECOMMENDATION
  INTEREST
  // UPVOTE
}

enum CommentSourceModule {
  TRACKER
  COORDINATE
  OUTREACH
  EVENT_DETAIL_PAGE
}

// discuss comment likes : comment / intent 

model EnquiryActivity {
  id              String                  @id @default(uuid()) @db.Uuid
  enquiryId       String                  @db.Uuid
  enquiry         Enquiry                 @relation(fields: [enquiryId], references: [id])
  userId          String                  @db.Uuid
  user            User                    @relation(fields: [userId], references: [id])
  accountId       String?                 @db.Uuid
  account         Account?                @relation(fields: [accountId], references: [id])
  activityType    EnquiryActivityType
  activitySubType EnquiryActivitySubType?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deleted         Boolean                 @default(false)
}

enum EnquiryActivityType {
  FOLLOW
  UPVOTE
}

enum EnquiryActivitySubType {
  ATTEND
  SPEAK
  SPONSOR
  EXHIBIT
}

model Export {
  id             String         @id @default(uuid()) @db.Uuid
  accountId      String         @db.Uuid
  account        Account        @relation(fields: [accountId], references: [id])
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id])
  exportFileType ExportFileType
  inputData      Json
  outputData     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deleted        Boolean        @default(false)
}

enum ExportFileType {
  CSV
  JSON
}

// discuss request table name
model UserActivity {
  id        String              @id @default(uuid()) @db.Uuid
  request   Json
  path      String
  source    UserActivitySource?
  userId    String              @db.Uuid
  accountId String?             @db.Uuid
  account   Account?            @relation(fields: [accountId], references: [id])
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: NoAction)
}

enum UserActivitySource {
  RESEARCH
  TRENDS
}

model ApiLogs {
  id        String   @id @default(uuid()) @db.Uuid
  request   Json
  path      String
  userId    String?  @db.Uuid
  accountId String?  @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Verification {
  passkey   String
  userId    String   @id @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  deleted   Boolean  @default(false)
}

// discuss if we want to expire access token after some time / after first use
model Access {
  id                  String             @id @default(uuid()) @db.Uuid
  sourceEntity        AccessSourceEntity
  sourceEntityId      String
  accessReceiverId    String             @db.Uuid
  accessReceiver      User               @relation(name: "accessReceiver", fields: [accessReceiverId], references: [id])
  accessProviderId    String             @db.Uuid
  accessProvider      User               @relation(name: "accessProvider", fields: [accessProviderId], references: [id])
  accessType          AccessType
  lastModifiedBy      String?            @db.Uuid
  token               String? // after first use token and expiry will be removed
  expiry              DateTime? // 7 days
  accessStatus        AccessStatus       @default(PENDING)
  accountId           String?            @db.Uuid
  account             Account?           @relation(fields: [accountId], references: [id])
  deletedBy           String?            @db.Uuid
  accessDeletedByUser User?              @relation(name: "accessDeletedByUser", fields: [deletedBy], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deleted             Boolean            @default(false)
}

enum AccessStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  DELETED
}

enum AccessSourceEntity {
  TRACKER
}

enum AccessType {
  SUPER_ADMIN
  ADMIN
  USER
}

model Tracker {
  id             String      @id @default(uuid()) @db.Uuid
  name           String?     @db.VarChar(200)
  filterValues   Json
  attachmentId   String?
  source         String?
  type           TrackerType @default(T_CUSTOM)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String      @db.Uuid
  deleted        Boolean     @default(false)
  lastModifiedBy String?     @db.Uuid
  createdByUser  User        @relation("createdByUser", fields: [createdBy], references: [id])
  modifiedByUser User?       @relation("modifiedByUser", fields: [lastModifiedBy], references: [id])
  accountId      String?     @db.Uuid
  account        Account?    @relation(fields: [accountId], references: [id])
}

enum TrackerType {
  T_PEOPLE_FINDER
  T_COMPETITOR
  T_SPEAKING_OPPORTUNITY
  T_AUDIENCE_DEPT_PROFILE
  T_PRODUCT_KEYWORDS
  T_BRAND_BUILDING
  T_RECRUITMENT
  T_CUSTOMER_ICP
  T_LOCATION
  T_VENUE
  T_GEOTIME
  T_CUSTOM
  TR_CUSTOM
}

model SavedLocation {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  type         LocationType
  locationId   String?
  geomType     GeomType?
  latitude     Float?
  longitude    Float?
  radius       Float?
  radiusUnit   RadiusUnit?
  locationName String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  area         Float?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String?      @db.Uuid
  account      Account?     @relation(fields: [accountId], references: [id])
  deleted      Boolean      @default(false)
}

enum LocationType {
  GEO_JSON
  LOCATION_ID
}

enum RadiusUnit {
  KM
  MI
}

enum GeomType {
  POINT
}


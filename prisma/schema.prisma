model UnlockedTransaction {
  id             String      @id @default(uuid()) @db.Uuid
  accountId      String      @db.Uuid
  unlockedById   String      @db.Uuid
  sourceId       String
  source         String
  unlockValue    UnlockValue
  target         UnlockType
  targetId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  unlockedByUser User        @relation(fields: [unlockedById], references: [id], onDelete: Cascade)
}

// enum UnlockSource {
//   CONTACT_DETAIL
//   EVENT_DETAIL
// }

enum UnlockType {
  USER
  EVENT
  COMPANY
}

enum UnlockValue {
  EMAIL
  PHONE
  BASIC
  ADVANCE
}

enum EventType {
  PARENT
  CHILD
}

enum EventSourceModule {
  PROMOTE
  COORDINATE
}

// EVENT GENI
model Event {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  data          Json
  referenceId   String?
  sourceModule  EventSourceModule @default(PROMOTE)
  deleted       Boolean           @default(false)
  attachmentId  String?           @db.Uuid
  type          EventType         @default(PARENT)
  createdAt     DateTime          @default(now())
  updateAt      DateTime          @updatedAt
  createdBy     String            @db.Uuid
  approval      Boolean           @default(true)
  capacity      Int               @default(0)
  registration  Boolean           @default(true)
  waitlisting   Boolean           @default(false)
  Attachment    Attachment?       @relation(fields: [attachmentId], references: [id])
  account       Account           @relation(fields: [accountId], references: [id])
  accountId     String            @db.Uuid
  User          User              @relation(fields: [createdBy], references: [id])
  parentEventId String?           @db.Uuid
  parentEvent   Event?            @relation(name: "parentEvent", fields: [parentEventId], references: [id])
  subEvents     Event[]           @relation("parentEvent")
  WidgetEvents  Widget[]          @relation("EventToWidget")
  // Widget        Widget?     @relation(fields: [widgetId], references: [id])
  // widgetId      String?     @db.Uuid
}

model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  email      String           @db.VarChar(50)
  entityType InvitationEntity @default(EVENT)
  entityId   String
  accountId  String           @db.Uuid
  userId     String           @db.Uuid
  createdAt  DateTime         @default(now())
  updateAt   DateTime         @updatedAt
  account    Account          @relation(fields: [accountId], references: [id])
  user       User             @relation(fields: [userId], references: [id])
}

enum InvitationEntity {
  EVENT
}

model Credit {
  id         String             @id @default(uuid()) @db.Uuid
  entityId   String             @db.VarChar(50)
  entityType UsageTrackerEntity @default(USER)
  creditType CreditType
  count      Int                @default(15)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([entityId])
}

enum UsageTrackerEntity {
  USER
}

enum CreditType {
  INVITAION
}

model Brand {
  domain    String   @unique
  name      String   @unique
  logoUrl   String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model CustomBrandKit {
  id         String   @id @default(uuid()) @db.Uuid
  data       Json?
  deleted    Boolean  @default(false)
  accountId  String   @unique @db.Uuid
  createdAt  DateTime @default(now())
  updateAt   DateTime @updatedAt
  color      String?
  fontFamily String?
  logoUrl    String?
  otherData  Json?
  createdBy  String   @db.Uuid
  user       User     @relation(references: [id], fields: [createdBy])
  widgets    Widget[]
  account    Account  @relation(fields: [accountId], references: [id])
}

model Widget {
  id                String          @id @default(uuid()) @db.Uuid
  customizationData Json?
  otherData         Json?
  domain            String?
  templatePublicId  Int
  type              WidgetType
  status            WidgetStatus
  eventId           Event[]         @relation("EventToWidget")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deleted           Boolean         @default(false)
  CustomBrandKit    CustomBrandKit? @relation(fields: [customBrandKitId], references: [id])
  customBrandKitId  String?         @db.Uuid
  createdBy         String          @db.Uuid
  user              User            @relation(fields: [createdBy], references: [id])
  accountId         String          @db.Uuid
  account           Account         @relation(fields: [accountId], references: [id])
}

enum WidgetType {
  Page
  Section
  StickyTop
  StickyFooter
  pop
  Pop
}

enum WidgetStatus {
  active
  draft
  deactivate
}

model RequestedJob {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  source    JobSource
  sourceId  String
  processId Int?
  status    JobStatus @default(PENDING)
  inputData Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum JobSource {
  SEND_SIGNIN_OTP
  SEND_SIGNUP_OTP
  SEND_ACCESS
  EVENT_CANCEl
  SEND_INVITE
  SEND_USER_INVITE
  SEND_INTEND_CREATE
  SEND_INTEND_UPDATE
  SEND_ERROR_MAIL
  SEND_DEMO_CONTACT_MAIL
}

enum JobStatus {
  PENDING
  COMPLETED
  FAILED
  PROCESSING
}

model Preset {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  totalEvent    Int           @default(0)
  data          Json
  newEventCount Int           @default(0)
  keywords      String?
  description   String?
  trackerType   TrackerType[]
  deleted       Boolean       @default(false)
  filterValue   Json
}

enum EnquiryStatus {
  PENDING
  IN_DISCUSSION
  SHORTLISTED
  IN_NEGOTIATION
  CONFIRMED
  CANCELLED
  REJECTED
}

enum InterestSourceModule {
  RESEARCH
  TRACKER
  COMMENT
  PROMOTED_EVENT
  PROMOTED_EVENT_WIDGET
  PROMOTED_EVENT_SPEAKER
  PROMOTED_EVENT_EXHIBITOR
}

enum InterestStatus {
  CONFIRMED
  PENDING
  SHORTLISTED
  REJECTED
  CANCELLED
  WAITLISTING
  FOLLOWING
  INVITATION
}

enum Interest {
  BOOKMARK
  ATTEND
  SPEAK
  SPONSOR
  EXHIBIT
  ORGANIZE
}

enum AttachmentEntityType {
  USER
  ACCOUNT
}

enum OnboardingState {
  VERIFICATION
  COMPLETED
  PROMOTED_USER
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum FileType {
  IMAGE
  PDF
  CSV
  JSON
}

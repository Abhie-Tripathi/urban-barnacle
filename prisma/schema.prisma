generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                @id @default(uuid()) @db.Uuid
  firstname                  String?
  lastname                   String?
  email                      String                @unique
  role                       UserRole              @default(CUSTOMER)
  source                     UserSource            @default(SELF)
  industry                   String?
  category                   String?
  subIndustry                String?
  socialIds                  Json?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  phoneNumber                String?
  primaryCompanyId           String?               @db.Uuid
  primaryAccountId           String?               @db.Uuid
  currentOnboardingState     OnboardingState       @default(VERIFICATION)
  primaryLocation            Json?
  imageUrl                   String?
  profileImageId             String?
  designation                String?
  department                 String?
  deleted                    Boolean               @default(false)
  accessProvided             Access[]              @relation("accessProvider")
  accessReceived             Access[]              @relation("accessReceiver")
  accessDeletedByUser        Access[]              @relation("accessDeletedByUser")
  apiLogs                    ApiLogs[]
  attachments                Attachment[]
  comments                   Comment[]
  lastModifiedConfigurations Configuration[]       @relation("lastModifiedBy")
  CustomBrandKit             CustomBrandKit[]
  initiatedEnquiries         Enquiry[]             @relation("initiatedBy")
  ownedEnquiries             Enquiry[]             @relation("owner")
  enquiryActivities          EnquiryActivity[]
  createdEvents              Event[]
  exports                    Export[]
  intents                    Intent[]
  Invitation                 Invitation[]
  requestedJobs              RequestedJob[]
  savedLocations             SavedLocation[]
  createdTrackers            Tracker[]             @relation("createdByUser")
  modifiedTrackers           Tracker[]             @relation("modifiedByUser")
  unlockedTransactions       UnlockedTransaction[]
  company                    Company?              @relation(fields: [primaryCompanyId], references: [id])
  userActivities             UserActivity[]
  approvingInterests         UserEventInterest[]   @relation("approvedBy")
  userInterests              UserEventInterest[]   @relation("interestedUser")
  recommendingInterests      UserEventInterest[]   @relation("recommendedBy")
  verificationPasskeys       Verification?
  Widget                     Widget[]
  accounts                   Account[]             @relation("AccountToUser")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  domain         String   @unique
  website        String?
  imageUrl       String?
  profileImageId String?
  accountId      String   @unique @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deleted        Boolean  @default(false)
  accounts       Account  @relation(fields: [accountId], references: [id])
  users          User[]
}

model Subscription {
  id                               String           @id @default(uuid()) @db.Uuid
  plan                             SubscriptionPlan @default(BASIC)
  planStartDate                    DateTime         @default(now())
  planRenewalDate                  DateTime?
  planMetaData                     Json?
  planFrequency                    PlanFrequency?
  planEndDate                      DateTime // default 1 year or 3 month
  purchaseValue                    Float            @default(0)
  currency                         Currency         @default(usd)
  pendingRequests                  Int              @default(200)
  pendingPocUnlockRequests         Int              @default(4400)
  pendingCompanySearchRequests     Int              @default(20)
  pendingProspectPocUnlockRequests Int              @default(200)
  accountId                        String?          @db.Uuid
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt
  currency_enum                    Currency?
  account                          Account?         @relation(fields: [accountId], references: [id])
}

enum PlanFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUALLY
}

enum Currency {
  usd
  USD
  INR
}

model Account {
  id                    String                @id @default(uuid()) @db.Uuid
  currentSubscriptionId String                @db.Uuid
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deleted               Boolean               @default(false)
  domain                String?
  configurationId       String                @unique @db.Uuid
  accessProvided        Access[]
  accountConfiguration  Configuration         @relation(fields: [configurationId], references: [id])
  apiLogs               ApiLogs[]
  comments              Comment[]
  company               Company?
  customBrandKit        CustomBrandKit?
  enquiries             Enquiry[]
  enquiryActivities     EnquiryActivity[]
  events                Event[]
  exports               Export[]
  intents               Intent[]
  invitations           Invitation[]
  savedLocations        SavedLocation[]
  subscription          Subscription[]
  trackers              Tracker[]
  unlockedTransactions  UnlockedTransaction[]
  userActivities        UserActivity[]
  userInterests         UserEventInterest[]
  widgets               Widget[]
  user                  User[]                @relation("AccountToUser")
}

model Attachment {
  id              String                 @id @default(uuid()) @db.Uuid
  fileUrl         String                 @unique
  fileType        FileType
  fileName        String
  fileSize        Float
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdByUserId String                 @db.Uuid
  deleted         Boolean                @default(false)
  sourceModule    AttachmentSourceModule
  sourceId        String
  createdByUser   User                   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  event           Event[]
  exports         Export[]               @relation("exportRelation")

  @@unique([fileUrl, fileSize])
}

model UserEventInterest {
  id               String               @id @default(uuid())
  accountId        String               @db.Uuid
  enquiryId        String?              @db.Uuid
  eventId          String
  note             String?
  sourceModule     InterestSourceModule
  sourceId         String?
  status           InterestStatus       @default(PENDING)
  interest         Interest
  modifiedBy       String               @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deleted          Boolean              @default(false)
  approvedBy       String?              @db.Uuid
  recommendedBy    String?              @db.Uuid
  interestedUserId String               @db.Uuid
  account          Account              @relation(fields: [accountId], references: [id])
  approvingUser    User?                @relation("approvedBy", fields: [approvedBy], references: [id])
  enquiry          Enquiry?             @relation(fields: [enquiryId], references: [id])
  interestedUser   User                 @relation("interestedUser", fields: [interestedUserId], references: [id])
  recommendingUser User?                @relation("recommendedBy", fields: [recommendedBy], references: [id])
}

model Enquiry {
  id              String              @id @default(uuid()) @db.Uuid
  status          EnquiryStatus       @default(PENDING)
  eventId         String
  accountId       String              @db.Uuid
  initiatedBy     String              @db.Uuid
  ownerId         String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deleted         Boolean             @default(false)
  account         Account             @relation(fields: [accountId], references: [id])
  initiatedByUser User                @relation("initiatedBy", fields: [initiatedBy], references: [id])
  owner           User?               @relation("owner", fields: [ownerId], references: [id])
  activities      EnquiryActivity[]
  userInterests   UserEventInterest[]

  @@unique([accountId, eventId], name: "unique_enquiry")
}

model Comment {
  id              String              @id @default(uuid()) @db.Uuid
  content         String?
  commentType     CommentType
  userId          String              @db.Uuid
  accountId       String              @db.Uuid
  sourceModule    CommentSourceModule
  sourceId        String
  parentCommentId String?             @db.Uuid
  totalLikes      Int                 @default(0)
  attachments     String[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deleted         Boolean             @default(false)
  account         Account             @relation(fields: [accountId], references: [id])
  parentComment   Comment?            @relation("parentComment", fields: [parentCommentId], references: [id])
  replies         Comment[]           @relation("parentComment")
  user            User                @relation(fields: [userId], references: [id])
}

model Intent {
  id           String             @id @default(uuid()) @db.Uuid
  targetModule IntentTargetModule
  targetId     String
  intentType   IntentType
  userId       String             @db.Uuid
  accountId    String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deleted      Boolean            @default(false)
  account      Account?           @relation(fields: [accountId], references: [id])
  user         User               @relation(fields: [userId], references: [id])

  @@unique([targetModule, targetId, userId, intentType, accountId], name: "unique_intent")
}

model EnquiryActivity {
  id              String                  @id @default(uuid()) @db.Uuid
  enquiryId       String                  @db.Uuid
  userId          String                  @db.Uuid
  accountId       String?                 @db.Uuid
  activityType    EnquiryActivityType
  activitySubType EnquiryActivitySubType?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deleted         Boolean                 @default(false)
  account         Account?                @relation(fields: [accountId], references: [id])
  enquiry         Enquiry                 @relation(fields: [enquiryId], references: [id])
  user            User                    @relation(fields: [userId], references: [id])
}

model Export {
  id             String             @id @default(uuid()) @db.Uuid
  accountId      String             @db.Uuid
  userId         String             @db.Uuid
  exportFileType ExportFileType
  inputData      Json
  outputData     Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deleted        Boolean            @default(false)
  exportOf       ExportSubSource
  fileSize       Float?
  fileUrl        String?
  source         ExportSourceModule
  sourceId       String?            @db.Uuid
  status         JobStatus          @default(PENDING)
  account        Account            @relation(fields: [accountId], references: [id])
  attachment     Attachment?        @relation("exportRelation", fields: [fileUrl, fileSize], references: [fileUrl, fileSize])
  user           User               @relation(fields: [userId], references: [id])
}

model UserActivity {
  id        String              @id @default(uuid()) @db.Uuid
  request   Json
  path      String
  source    UserActivitySource?
  userId    String              @db.Uuid
  accountId String?             @db.Uuid
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  account   Account?            @relation(fields: [accountId], references: [id])
  user      User                @relation(fields: [userId], references: [id], onDelete: NoAction)
}

model ApiLogs {
  id        String   @id @default(uuid()) @db.Uuid
  request   Json
  path      String
  userId    String?  @db.Uuid
  accountId String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account? @relation(fields: [accountId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model Verification {
  passkey   String
  userId    String   @id @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  deleted   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Access {
  id                  String             @id @default(uuid()) @db.Uuid
  sourceEntity        AccessSourceEntity
  sourceEntityId      String
  accessReceiverId    String             @db.Uuid
  accessProviderId    String             @db.Uuid
  accessType          AccessType
  lastModifiedBy      String?            @db.Uuid
  token               String?
  expiry              DateTime?
  accessStatus        AccessStatus       @default(PENDING)
  accountId           String?            @db.Uuid
  deletedBy           String?            @db.Uuid
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deleted             Boolean            @default(false)
  accessProvider      User               @relation("accessProvider", fields: [accessProviderId], references: [id])
  accessReceiver      User               @relation("accessReceiver", fields: [accessReceiverId], references: [id])
  account             Account?           @relation(fields: [accountId], references: [id])
  accessDeletedByUser User?              @relation("accessDeletedByUser", fields: [deletedBy], references: [id])
}

model Tracker {
  id             String      @id @default(uuid()) @db.Uuid
  name           String?     @db.VarChar(200)
  filterValues   Json
  attachmentId   String?
  type           TrackerType @default(T_CUSTOM)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String      @db.Uuid
  deleted        Boolean     @default(false)
  lastModifiedBy String?     @db.Uuid
  accountId      String?     @db.Uuid
  source         String?
  account        Account?    @relation(fields: [accountId], references: [id])
  createdByUser  User        @relation("createdByUser", fields: [createdBy], references: [id])
  modifiedByUser User?       @relation("modifiedByUser", fields: [lastModifiedBy], references: [id])
}

model SavedLocation {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  type         LocationType
  locationId   String?
  geomType     GeomType?
  latitude     Float?
  longitude    Float?
  radius       Float?
  radiusUnit   RadiusUnit?
  locationName String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  area         Float?
  accountId    String?      @db.Uuid
  deleted      Boolean      @default(false)
  account      Account?     @relation(fields: [accountId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Configuration {
  id               String   @id @default(uuid()) @db.Uuid
  config           Json
  lastModifiedById String?  @db.Uuid
  tag              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  account          Account?
  lastModifiedBy   User?    @relation("lastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: Cascade)
}

model UnlockedTransaction {
  id             String      @id @default(uuid()) @db.Uuid
  accountId      String      @db.Uuid
  unlockedById   String      @db.Uuid
  sourceId       String
  source         String
  unlockValue    UnlockValue
  target         UnlockType
  targetId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  unlockedByUser User        @relation(fields: [unlockedById], references: [id], onDelete: Cascade)
}

model Event {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  data          Json
  deleted       Boolean           @default(false)
  attachmentId  String?           @db.Uuid
  type          EventType         @default(PARENT)
  createdAt     DateTime          @default(now())
  updateAt      DateTime          @updatedAt
  createdBy     String            @db.Uuid
  approval      Boolean           @default(true)
  capacity      Int               @default(0)
  registration  Boolean           @default(true)
  waitlisting   Boolean           @default(false)
  accountId     String            @db.Uuid
  parentEventId String?           @db.Uuid
  referenceId   String?
  sourceModule  EventSourceModule @default(PROMOTE)
  account       Account           @relation(fields: [accountId], references: [id])
  Attachment    Attachment?       @relation(fields: [attachmentId], references: [id])
  User          User              @relation(fields: [createdBy], references: [id])
  parentEvent   Event?            @relation("parentEvent", fields: [parentEventId], references: [id])
  subEvents     Event[]           @relation("parentEvent")
  WidgetEvents  Widget[]          @relation("EventToWidget")
}

model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  email      String           @db.VarChar(50)
  entityType InvitationEntity @default(EVENT)
  entityId   String
  accountId  String           @db.Uuid
  userId     String           @db.Uuid
  createdAt  DateTime         @default(now())
  updateAt   DateTime         @updatedAt
  account    Account          @relation(fields: [accountId], references: [id])
  user       User             @relation(fields: [userId], references: [id])
}

model Credit {
  id         String             @id @default(uuid()) @db.Uuid
  entityId   String             @db.VarChar(50)
  entityType UsageTrackerEntity @default(USER)
  creditType CreditType
  count      Int                @default(15)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([entityId])
}

model Brand {
  domain    String   @unique
  name      String   @unique
  logoUrl   String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model CustomBrandKit {
  id         String   @id @default(uuid()) @db.Uuid
  data       Json?
  deleted    Boolean  @default(false)
  accountId  String   @unique @db.Uuid
  createdAt  DateTime @default(now())
  updateAt   DateTime @updatedAt
  color      String?
  fontFamily String?
  logoUrl    String?
  otherData  Json?
  createdBy  String   @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id])
  user       User     @relation(fields: [createdBy], references: [id])
  widgets    Widget[]
}

model Widget {
  id                String          @id @default(uuid()) @db.Uuid
  customizationData Json?
  otherData         Json?
  domain            String?
  templatePublicId  Int
  type              WidgetType
  status            WidgetStatus
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deleted           Boolean         @default(false)
  customBrandKitId  String?         @db.Uuid
  createdBy         String          @db.Uuid
  accountId         String          @db.Uuid
  account           Account         @relation(fields: [accountId], references: [id])
  user              User            @relation(fields: [createdBy], references: [id])
  CustomBrandKit    CustomBrandKit? @relation(fields: [customBrandKitId], references: [id])
  eventId           Event[]         @relation("EventToWidget")
}

model RequestedJob {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  source    JobSource
  sourceId  String
  processId Int?
  status    JobStatus @default(PENDING)
  inputData Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preset {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  totalEvent    Int           @default(0)
  data          Json
  newEventCount Int           @default(0)
  keywords      String?
  description   String?
  trackerType   TrackerType[]
  deleted       Boolean       @default(false)
  filterValue   Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
}

model ContactEnquiry {
  id           String                     @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String
  email        String
  subscribe    Boolean                    @default(false)
  sourceModule ContactEnquirySourceModule
  data         Json
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model SimilarEventsToTracker {
  id        String         @id @default(uuid())
  trackerId String
  eventId   String
  tag       TrackerTypeTag
  sourceId  Int
  score     Float
  count     Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum UserSource {
  SELF
  PROMOTE_EVENT
  PROMOTE_EVENT_INVITE
  ACCESS_INVITE
  SCRIPT
  IMPORT_10T
  IMPORT_9T
}

enum SubscriptionPlan {
  BASIC
  ESSENTIAL
  SCALE
  ADVANCE
  ENTERPRISE
}

enum AttachmentSourceModule {
  COMMENT
  TRACKER
  USER
  ACCOUNT
  EVENT
  BRANDKIT
  PROMOTED_EVENT
  PROMOTED_EVENT_WIDGET_KIT
  PROMOTED_EVENT_SPEAKER
  PROMOTED_EVENT_EXHIBITOR
  OTHERS
}

enum IntentTargetModule {
  COMMENT
}

enum IntentType {
  UPVOTE
}

enum CommentType {
  TEXT
  RECOMMENDATION
  INTEREST
}

enum CommentSourceModule {
  TRACKER
  COORDINATE
  OUTREACH
  EVENT_DETAIL_PAGE
}

enum EnquiryActivityType {
  FOLLOW
  UPVOTE
}

enum EnquiryActivitySubType {
  ATTEND
  SPEAK
  SPONSOR
  EXHIBIT
}

enum ExportSubSource {
  TRACKER_NEW_EVENT
  TRACKER_PAST_EVENT
  TRACKER_ACTIVE_EVENT
  TRACKER_BUSINESS_EVENT
  TRACKER_SOCIAL_EVENT
  TRACKER_UNATTENDED_EVENT
  EVENT
}

enum ExportSourceModule {
  TRACKER
  RESEARCH
}

enum ExportFileType {
  CSV
  JSON
  EXCEL
}

enum UserActivitySource {
  RESEARCH
  TRENDS
}

enum AccessStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  DELETED
}

enum AccessSourceEntity {
  TRACKER
}

enum AccessType {
  SUPER_ADMIN
  ADMIN
  USER
}

enum TrackerType {
  T_PEOPLE_FINDER
  T_COMPETITOR
  T_SPEAKING_OPPORTUNITY
  T_AUDIENCE_DEPT_PROFILE
  T_PRODUCT_KEYWORDS
  T_BRAND_BUILDING
  T_RECRUITMENT
  T_CUSTOMER_ICP
  T_LOCATION
  T_VENUE
  T_GEOTIME
  T_CUSTOM
  TR_CUSTOM
  T_EVENT_PARTICIPATION
}

enum LocationType {
  GEO_JSON
  LOCATION_ID
}

enum RadiusUnit {
  KM
  MI
}

enum GeomType {
  POINT
}

enum UnlockType {
  USER
  EVENT
  COMPANY
}

enum UnlockValue {
  EMAIL
  PHONE
  BASIC
  ADVANCE
}

enum EventType {
  PARENT
  CHILD
}

enum EventSourceModule {
  PROMOTE
  COORDINATE
}

enum InvitationEntity {
  EVENT
}

enum UsageTrackerEntity {
  USER
}

enum CreditType {
  INVITAION
}

enum WidgetType {
  Page
  Section
  StickyTop
  StickyFooter
  pop
  Pop
}

enum WidgetStatus {
  active
  draft
  deactivate
}

enum JobSource {
  SEND_SIGNIN_OTP
  SEND_SIGNUP_OTP
  SEND_ACCESS
  EVENT_CANCEl
  SEND_INVITE
  SEND_USER_INVITE
  SEND_INTEND_CREATE
  SEND_INTEND_UPDATE
  SEND_ERROR_MAIL
  SEND_DEMO_CONTACT_MAIL
  SEND_TRACKER_EXPORT_MAIL
  SEND_CONTACT_US_EMAIL
  SEND_CONTACT_ERROR_EMAIL
}

enum JobStatus {
  PENDING
  COMPLETED
  FAILED
  PROCESSING
}

enum EnquiryStatus {
  PENDING
  IN_DISCUSSION
  SHORTLISTED
  IN_NEGOTIATION
  CONFIRMED
  CANCELLED
  REJECTED
}

enum InterestSourceModule {
  RESEARCH
  TRACKER
  COMMENT
  PROMOTED_EVENT
  PROMOTED_EVENT_WIDGET
  PROMOTED_EVENT_SPEAKER
  PROMOTED_EVENT_EXHIBITOR
}

enum InterestStatus {
  CONFIRMED
  PENDING
  SHORTLISTED
  REJECTED
  CANCELLED
  WAITLISTING
  FOLLOWING
  INVITATION
}

enum Interest {
  BOOKMARK
  ATTEND
  SPEAK
  SPONSOR
  EXHIBIT
  ORGANIZE
}

enum AttachmentEntityType {
  USER
  ACCOUNT
}

enum OnboardingState {
  VERIFICATION
  COMPLETED
  PROMOTED_USER
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum FileType {
  IMAGE
  PDF
  CSV
  JSON
  EXCEL
}

enum ContactEnquirySourceModule {
  DEMO
  CONTACT_US
  ERROR
}

enum TrackerTypeTag {
  ACTIVE
  PAST
  NEW
}

